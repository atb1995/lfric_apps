      if ( coarse_aerosol_ancil .and. .not. coarse_rad_aerosol ) then
        call aerosol_fields%get_field('acc_ins_du_coarse', acc_ins_du_c)
        call aerosol_fields%get_field('n_acc_ins_coarse', n_acc_ins_c)
        call aerosol_fields%get_field('cor_ins_du_coarse', cor_ins_du_c)
        call aerosol_fields%get_field('n_cor_ins_coarse', n_cor_ins_c)

        call map_scalar_intermesh(acc_ins_du_c, acc_ins_du)
        call map_scalar_intermesh(n_acc_ins_c, n_acc_ins)
        call map_scalar_intermesh(cor_ins_du_c, cor_ins_du)
        call map_scalar_intermesh(n_cor_ins_c, n_cor_ins)
        
        call n_acc_ins_c%write_field('aerosol__n_acc_ins_coarse')
        call acc_ins_du_c%write_field('aerosol__acc_ins_du_coarse')
        call n_cor_ins_c%write_field('aerosol__n_cor_ins_coarse')
        call cor_ins_du_c%write_field('aerosol__cor_ins_du_coarse')
