!> @brief Interface to the UKCA GLOMAP-mode aerosol scheme

module aerosol_ukca_alg_mod

  use mesh_mod, only: mesh_type
  use model_clock_mod, only: model_clock_type
  use function_space_mod,              only: function_space_type
  use function_space_collection_mod,   only: function_space_collection
  use intermesh_mappings_alg_mod,      only: map_scalar_intermesh, &
                                             map_rho_intermesh,     &
                                             map_integer_intermesh, &
                                             map_mr_bundle_intermesh, &
                                             round_to_integer
  use multires_coupling_config_mod,    only: lowest_order_aero_flag, &
                                             coarse_rad_aerosol
  use initialization_config_mod,  only: coarse_aerosol_ancil
  use multidata_field_dimensions_mod, &
                                       only: get_ndata_val => get_multidata_field_dimension

  implicit none

  private
  public aerosol_ukca_alg

contains

  !>@brief Runs the UKCA GLOMAP-mode aerosol scheme
  !>@details The UKCA GLOMAP-mode aerosol scheme is run with aerosol pre-cursor
  !>         species provided by UKCA's Offline Oxidants chemistry scheme
  !>         to calculate cloud droplet number concentration (CDNC) and the
  !>         aerosol fields required by RADAER
  !>@param[in] chemistry_fields      Fields for UKCA chemistry schemes
  !>@param[in] aerosol_fields        Fields for GLOMAP aerosol scheme
  !>@param[in] radiation_fields      Fields for radiation scheme
  !>@param[in] derived_fields        Fields derived from the state
  !>@param[in] microphysics_fields   Fields for microphysics scheme
  !>@param[in] turbulence_fields     Fields for turbulence scheme
  !>@param[in] convection_fields     Fields for convection scheme
  !>@param[in] cloud_fields          Fields for cloud scheme
  !>@param[in] surface_fields        Fields for surface scheme
  !>@param[in] soil_fields           Fields for soil hydrology scheme
  !>@param[in] state                 Dynamics state
  !>@param[in] mr                    Mixing ratios
  !>@param[in] model_clock           Time in model

  subroutine aerosol_ukca_alg( chemistry_fields,                               &
                               aerosol_fields,                                 &
                               radiation_fields,                               &
                               derived_fields,                                 &
                               microphysics_fields,                            &
                               turbulence_fields,                              &
                               convection_fields,                              &
                               cloud_fields,                                   &
                               surface_fields,                                 &
                               soil_fields,                                    &
                               state,                                          &
                               mr,                                             &
                               model_clock )


    use field_mod,                     only: field_type
    use integer_field_mod,             only: integer_field_type
    use field_collection_mod,          only: field_collection_type
    use moist_dyn_mod,                 only: num_moist_factors, total_mass
    use fs_continuity_mod,             only: W3, Wtheta
    use function_space_collection_mod, only: function_space_collection
    use function_space_mod,            only: function_space_type
    use multidata_field_dimensions_mod, only :                                 &
        get_ndata_val => get_multidata_field_dimension
    use mesh_collection_mod,           only: mesh_collection
    use extrusion_mod,                 only: SHIFTED, TWOD
    use field_indices_mod,             only: igh_t, igh_p, igh_d
    use mr_indices_mod,                only: imr_v, imr_cl, imr_ci, imr_s, nummr
    use constants_mod,                 only: i_timestep, i_def, r_def, l_def
    use sci_geometric_constants_mod,   only: get_latitude_fv,                  &
                                             get_longitude_fv,                 &
                                             get_height_fv, get_da_msl_proj,   &
                                             get_detj_at_w3_fv
    use physics_constants_mod,         only: get_rdz_w3, get_dtrdz_wth
    use aerosol_ukca_kernel_mod,       only: aerosol_ukca_kernel_type

    use io_config_mod,                 only: subroutine_timers, use_xios_io,   &
                                             write_diag
    use xios,                          only: xios_date, xios_get_current_date, &
                                             xios_date_get_day_of_year,        &
                                             xios_date_get_second_of_day
    use timer_mod,                     only: timer
    use log_mod,                       only: log_event, LOG_LEVEL_DEBUG, LOG_LEVEL_INFO

    use chemistry_config_mod,          only: chem_scheme,                      &
                                             chem_scheme_strattrop,            &
                                             chem_scheme_strat_test,           &
                                             chem_timestep,                    &
                                             photol_scheme, photol_scheme_off, &
                                             photol_scheme_prescribed,         &
                                             photol_scheme_fastjx    

    use sci_field_minmax_alg_mod,      only: log_field_minmax
    use microphysics_config_mod,       only: microphysics_casim
    use ukca_scalar_gas_init_mod,      only: atmospheric_ccl4,                 &
                                             atmospheric_cfc113,               &
                                             atmospheric_cfc114,               &
                                             atmospheric_cfc115,               &
                                             atmospheric_cfc11,                &
                                             atmospheric_cfc12,                &
                                             atmospheric_ch2br2,               &
                                             atmospheric_chbr3,                &
                                             atmospheric_ch4,                  &
                                             atmospheric_co2,                  &
                                             atmospheric_csul,                 &
                                             atmospheric_h1202,                &
                                             atmospheric_h1211,                &
                                             atmospheric_h1301,                &
                                             atmospheric_h2,                   &
                                             atmospheric_h2402,                &
                                             atmospheric_hfc125,               &
                                             atmospheric_hfc134a,              &
                                             atmospheric_hcfc141b,             &
                                             atmospheric_hcfc142b,             &
                                             atmospheric_hcfc22,               &
                                             atmospheric_mebr,                 &
                                             atmospheric_meccl3,               &
                                             atmospheric_mecl,                 &
                                             atmospheric_n2,                   &
                                             atmospheric_n2o,                  &
                                             atmospheric_o2

    use um_sizes_init_mod,             only: um_sizes_init
    use um_ukca_init_mod,              only: n_phot_spc, ratj_varnames
    use ukca_photol_param_mod,         only: jppj, jrate_fac, jp_names
  
    use pseudo_photol_kernel_mod,      only: pseudo_photol_kernel_type
    use map_pseudophotol_kernel_mod,   only: map_pseudophotol_kernel_type
    use calc_albedo_kernel_mod,        only: calc_albedo_kernel_type
    use photol_kernel_mod,             only: photol_kernel_type
    use msat_kernel_mod,               only: msat_kernel_type
    use photol_diags_kernel_mod,       only: photol_diags_kernel_type
    use illuminate_kernel_mod,         only: illuminate_kernel_type
    use model_clock_mod,               only: model_clock_type
    use moist_dyn_factors_alg_mod,     only: moist_dyn_factors_alg
    use physics_mappings_alg_mod,    only: map_physics_scalars

    implicit none

    ! -- Arguments --

    type( field_collection_type ), intent(in) :: derived_fields
    type( field_collection_type ), intent(in) :: radiation_fields
    type( field_collection_type ), intent(in) :: microphysics_fields
    type( field_collection_type ), intent(in) :: turbulence_fields
    type( field_collection_type ), intent(in) :: convection_fields
    type( field_collection_type ), intent(in) :: cloud_fields
    type( field_collection_type ), intent(in) :: surface_fields
    type( field_collection_type ), intent(in) :: soil_fields
    type( field_collection_type ), intent(in) :: chemistry_fields
    type( field_collection_type ), intent(in) :: aerosol_fields
    type( field_type ), intent(in) :: state(:)
    type( field_type ), intent(in) :: mr(:)
    class(model_clock_type), intent(in) :: model_clock
    real(kind=r_def), intent(in) :: dt
    class( model_clock_type ), intent(in) :: clock

    ! -- Local variables --

    ! Temporary unpacked fields from collections
    ! Coarse Dust Fields
    ! =================== Runtime Fields ============================== !
    type( field_type ), pointer :: latitude_w3_aero  ! Runtime
    type( field_type ), pointer :: longitude_w3_aero ! Runtime
    type( field_type ), pointer :: height_w3_aero    ! Runtime
    type( field_type ), pointer :: height_wth_aero   ! Runtime
    type( field_type ), pointer :: rdz_w3_aero       ! Runtime
    type( field_type ), pointer :: cell_area_aero    ! Runtime
    type( field_type ), pointer :: detj_shifted_aero ! Runtime
    type( field_type ), pointer :: dtrdz_coarse_wtheta ! Runtime

    ! =================== Scalar W3/WTHETA Fields ============================== !

    type( field_type ), pointer :: ls_rain_3d_aero ! Scalar WTheta
    type( field_type ), pointer :: ls_snow_3d_aero ! Scalar WTheta
    type( field_type ), pointer :: autoconv_aero   ! Scalar WTheta
    type( field_type ), pointer :: accretion_aero  ! Scalar WTheta
    type( field_type ), pointer :: rim_cry_aero    ! Scalar WTheta
    type( field_type ), pointer :: rim_agg_aero    ! Scalar WTheta

    type( field_type ), target :: ls_rain_3d_coarse  ! Scalar WTheta
    type( field_type ), target :: ls_snow_3d_coarse  ! Scalar WTheta
    type( field_type ), target :: autoconv_coarse    ! Scalar WTheta
    type( field_type ), target :: accretion_coarse   ! Scalar WTheta
    type( field_type ), target :: rim_cry_coarse     ! Scalar WTheta
    type( field_type ), target :: rim_agg_coarse     ! Scalar WTheta

    type( field_type ), pointer :: theta_aero      ! Scalar WTheta
    type( field_type ), pointer :: exner_aero      ! Scalar W3
    type( field_type ), pointer :: exner_in_wth_aero ! Scalar WTheta

    type( field_type ), target :: theta_coarse        ! Scalar WTheta
    type( field_type ), target :: exner_coarse        ! Scalar W3
    type( field_type ), target :: exner_in_wth_coarse ! Scalar WTheta

    type( field_type ), pointer :: conv_rain_3d_aero ! Scalar Wtheta
    type( field_type ), pointer :: conv_snow_3d_aero ! Scalar Wtheta
    type( field_type ), pointer :: cca_aero          ! Scalar Wtheta

    type( field_type ), target :: conv_rain_3d_coarse ! Scalar Wtheta
    type( field_type ), target :: conv_snow_3d_coarse ! Scalar Wtheta
    type( field_type ), target :: cca_coarse          ! Scalar Wtheta

    type( field_type ), pointer :: bulk_fraction_aero   ! Scalar Wtheta
    type( field_type ), pointer :: liquid_fraction_aero ! Scalar Wtheta
    type( field_type ), pointer :: area_fraction_aero   ! Scalar Wtheta

    type( field_type ), target :: bulk_fraction_coarse   ! Scalar Wtheta
    type( field_type ), target :: liquid_fraction_coarse ! Scalar Wtheta
    type( field_type ), target :: area_fraction_coarse   ! Scalar Wtheta

    type( field_type ), pointer :: z0m_aero ! Scalar W3 2D
    type( field_type ), pointer :: ustar_aero ! Scalar W3 2D

    type( field_type ), target :: z0m_coarse ! Scalar W3 2D
    type( field_type ), target :: ustar_coarse ! Scalar W3 2D

    type( field_type ), pointer :: zh_aero ! Scalar W3 2D
    type( field_type ), pointer :: rhokh_bl_aero ! Scalar W3
    type( field_type ), pointer :: zhsc_aero ! Scalar W3 2D

    type( field_type ), target :: zh_coarse ! Scalar W3 2D
    type( field_type ), target :: rhokh_bl_coarse ! Scalar W3
    type( field_type ), target :: zhsc_coarse ! Scalar W3 2D

    ! =================== Multidata Scalar W3/WTHETA Fields ============================== !
    type( field_type ), pointer :: dust_flux_aero    ! Scalar W3 2D Multidata
    
    type( field_type ), target :: dust_flux_coarse    ! Scalar W3 2D Multidata

    type( field_type ), pointer :: ent_we_lim_aero ! Scalar W3 2D Multidata
    type( field_type ), pointer :: ent_t_frac_aero ! Scalar W3 2D Multidata
    type( field_type ), pointer :: ent_zrzi_aero   ! Scalar W3 2D Multidata
    type( field_type ), pointer :: ent_we_lim_dsc_aero ! Scalar W3 2D Multidata
    type( field_type ), pointer :: ent_zrzi_dsc_aero ! Scalar W3 2D Multidata

    type( field_type ), target :: ent_we_lim_coarse ! Scalar W3 2D Multidata
    type( field_type ), target :: ent_t_frac_coarse ! Scalar W3 2D Multidata
    type( field_type ), target :: ent_zrzi_coarse   ! Scalar W3 2D Multidata
    type( field_type ), target :: ent_we_lim_dsc_coarse ! Scalar W3 2D Multidata
    type( field_type ), target :: ent_zrzi_dsc_coarse ! Scalar W3 2D Multidata


    ! =================== Integer W3/WTHETA Fields ============================== !

    type( field_type ), pointer :: cv_base_aero      ! Integer W3 2D
    type( field_type ), pointer :: cv_top_aero       ! Integer W3 2D

    type( field_type ), target :: cv_base_coarse      ! Integer W3 2D
    type( field_type ), target :: cv_top_coarse       ! Integer W3 2D

    type( integer_field_type ), pointer :: level_ent_aero ! Integer W3 2D
    type( integer_field_type ), pointer :: level_ent_dsc_aero ! Integer W3 2D

    type( integer_field_type ), target :: level_ent_coarse ! Integer W3 2D
    type( integer_field_type ), target :: level_ent_dsc_coarse ! Integer W3 2D


    ! =================== Moisture Fields ============================== !

    type (field_type), pointer :: mr_aero(:)     ! Scalar Wtheta (Moisture Mapping Required)
    type (field_type), pointer :: mr_ice_aero        ! Scalar Wtheta (Moisture Mapping Required)

    type (field_type), target :: mr_coarse(nummr)     ! Scalar Wtheta (Moisture Mapping Required)
    type (field_type), target :: mr_ice_coarse        ! Scalar Wtheta (Moisture Mapping Required)

    type (field_type) :: moist_dyn_coarse(num_moist_factors)

    ! =================== Compute Again Fields ============================== !

    type( field_type ), pointer :: wetrho_in_w3_aero ! Scalar W3, COMPUTE ON OTHER MESH!!!
    type( field_type ), pointer :: wetrho_in_wth_aero ! Scalar WTheta, COMPUTE ON OTHER MESH!!!

    type( field_type ), target :: wetrho_in_w3_coarse ! Scalar W3, COMPUTE ON OTHER MESH!!!
    type( field_type ), target :: wetrho_in_wth_coarse ! Scalar WTheta, COMPUTE ON OTHER MESH!!!

    type( field_type ), pointer :: ent_t_frac_dsc_aero ! Scalar W3 2D Multidata COMPUTE ON OTHER MESH!!!

    type( field_type ), target :: ent_t_frac_dsc_coarse ! Scalar W3 2D Multidata COMPUTE ON OTHER MESH!!!

    type( field_type ), pointer :: dtrdz_tq_bl_aero ! Compute on other mesh!!!
    type( field_type ), target :: dtrdz_tq_bl_coarse ! Compute on other mesh!!!

    ! =================== Tile Fields ============================== !
    
    type( field_type ), pointer :: tile_fraction_aero ! Special Tile Mapping?
    type( field_type ), pointer :: tile_temperature_aero ! Special Tile Mapping?

    type( field_type ), target :: tile_fraction_coarse ! Special Tile Mapping?
    type( field_type ), target :: tile_temperature_coarse ! Special Tile Mapping?

    ! =================== Unsure Fields ============================== !
    type( field_type ), pointer :: sin_stellar_declination_rts_aero ! ???
    type( field_type ), pointer :: stellar_eqn_of_time_rts_aero     ! ???
    integer(i_def), save :: current_year, day_of_year
    real(r_def), save :: second_of_day
    type( field_type ), target :: sin_stellar_declination_rts_coarse ! ???
    type( field_type ), target :: stellar_eqn_of_time_rts_coarse     ! ???
    type(field_type) :: cos_zenith_angle_coarse , lit_fraction_coarse , &
                        cos_zenith_angle_rts_coarse , lit_fraction_rts_coarse , &
                        stellar_irradiance_rts_coarse , &
                        orographic_correction_rts_coarse , &
                        slope_angle_coarse, slope_aspect_coarse , &
                        horizon_angle_coarse , horizon_aspect_coarse 

    ! Required as is first field in kernel
    type( field_type ), target  :: o3p_coarse
    type( field_type ), pointer :: o3p_aero

    type( mesh_type ),  pointer :: mesh
    type( mesh_type ),  pointer :: aero_mesh
    type( mesh_type ),  pointer :: aero_2d_mesh
    type( mesh_type ),  pointer :: shifted_mesh
    type( function_space_type ), pointer :: vector_space
    type( mesh_type ),  pointer :: shifted_aero_mesh

    type( field_type ), pointer :: latitude_w3
    type( field_type ), pointer :: longitude_w3
    type( field_type ), pointer :: height_w3
    type( field_type ), pointer :: height_wth
    type( field_type ), pointer :: rdz_w3
    type( field_type ), pointer :: cell_area
    type( field_type ), pointer :: detj_shifted

    ! Radiation fields
    type( field_type ), pointer :: sin_stellar_declination_rts
    type( field_type ), pointer :: stellar_eqn_of_time_rts

    type( field_type ), pointer :: sw_up_tile
    type( field_type ), pointer :: sw_down_surf
  
    ! Microphysics fields
    type( field_type ), pointer :: ls_rain_3d
    type( field_type ), pointer :: ls_snow_3d
    type( field_type ), pointer :: autoconv
    type( field_type ), pointer :: accretion
    type( field_type ), pointer :: rim_cry
    type( field_type ), pointer :: rim_agg

    ! Turbulence fields
    type( field_type ), pointer :: tke_bl
    type( field_type ), pointer :: zh
    type( field_type ), pointer :: rhokh_bl
    type( field_type ), pointer :: dtrdz_tq_bl
    type( field_type ), pointer :: zhsc
    type( integer_field_type ), pointer :: level_ent
    type( integer_field_type ), pointer :: level_ent_dsc
    type( field_type ), pointer :: ent_we_lim
    type( field_type ), pointer :: ent_t_frac
    type( field_type ), pointer :: ent_zrzi
    type( field_type ), pointer :: ent_we_lim_dsc
    type( field_type ), pointer :: ent_t_frac_dsc
    type( field_type ), pointer :: ent_zrzi_dsc

    ! Convection fields
    type( field_type ), pointer :: conv_rain_3d
    type( field_type ), pointer :: conv_snow_3d
    type( field_type ), pointer :: cv_base
    type( field_type ), pointer :: cv_top
    type( field_type ), pointer :: cca

    ! Cloud fields
    type( field_type ), pointer :: bulk_fraction
    type( field_type ), pointer :: liquid_fraction
    type( field_type ), pointer :: area_fraction

    ! Surface fields
    type( field_type ), pointer :: tile_fraction
    type( field_type ), pointer :: tile_temperature
    type( field_type ), pointer :: tile_heat_flux
    type( field_type ), pointer :: gc_tile
    type( field_type ), pointer :: leaf_area_index
    type( field_type ), pointer :: canopy_height
    type( field_type ), pointer :: z0m
    type( field_type ), pointer :: ustar
    type( field_type ), pointer :: wspd10m
    type( field_type ), pointer :: chloro_sea
    type( field_type ), pointer :: urbztm

    ! Soil fields
    type( field_type ), pointer :: soil_moisture
    type( field_type ), pointer :: soil_roughness

    ! Chemistry fields
    type( field_type ), pointer :: o3p
    type( field_type ), pointer :: o1d
    type( field_type ), pointer :: o3
    type( field_type ), pointer :: n
    type( field_type ), pointer :: no
    type( field_type ), pointer :: no3
    type( field_type ), pointer :: lumped_n
    type( field_type ), pointer :: no2
    type( field_type ), pointer :: n2o5
    type( field_type ), pointer :: ho2no2
    type( field_type ), pointer :: hono2
    type( field_type ), pointer :: h2o2
    type( field_type ), pointer :: ch4
    type( field_type ), pointer :: co
    type( field_type ), pointer :: hcho
    type( field_type ), pointer :: meoo
    type( field_type ), pointer :: meooh
    type( field_type ), pointer :: h
    type( field_type ), pointer :: oh
    type( field_type ), pointer :: ho2
    type( field_type ), pointer :: cl
    type( field_type ), pointer :: cl2o2
