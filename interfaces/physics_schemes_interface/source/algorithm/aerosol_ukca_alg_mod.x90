    call chemistry_fields%get_field('h2',h2)
    call chemistry_fields%get_field('meoh',meoh)
    call chemistry_fields%get_field('msa',msa)
    call chemistry_fields%get_field('nh3',nh3)
    call chemistry_fields%get_field('cs2',cs2)
    call chemistry_fields%get_field('csul',csul)
    call chemistry_fields%get_field('h2s',h2s)
    call chemistry_fields%get_field('so3',so3)
    call chemistry_fields%get_field('passive_o3',passive_o3)
    call chemistry_fields%get_field('age_of_air',age_of_air)

    ! Aerochem fields
    call chemistry_fields%get_field('h2o2_limit', h2o2_limit)
    call chemistry_fields%get_field('dms', dms)
    call chemistry_fields%get_field('so2', so2)
    call chemistry_fields%get_field('h2so4', h2so4)
    call chemistry_fields%get_field('dmso', dmso)
    call chemistry_fields%get_field('monoterpene', monoterpene)
    call chemistry_fields%get_field('secondary_organic', secondary_organic)

    ! Aerosol fields
    call aerosol_fields%get_field('n_nuc_sol', n_nuc_sol)
    call aerosol_fields%get_field('nuc_sol_su', nuc_sol_su)
    call aerosol_fields%get_field('nuc_sol_om', nuc_sol_om)
    call aerosol_fields%get_field('n_ait_sol', n_ait_sol)
    call aerosol_fields%get_field('ait_sol_su', ait_sol_su)
    call aerosol_fields%get_field('ait_sol_bc', ait_sol_bc)
    call aerosol_fields%get_field('ait_sol_om', ait_sol_om)
    call aerosol_fields%get_field('n_acc_sol', n_acc_sol)
    call aerosol_fields%get_field('acc_sol_su', acc_sol_su)
    call aerosol_fields%get_field('acc_sol_bc', acc_sol_bc)
    call aerosol_fields%get_field('acc_sol_om', acc_sol_om)
    call aerosol_fields%get_field('acc_sol_ss', acc_sol_ss)
    call aerosol_fields%get_field('n_cor_sol', n_cor_sol)
    call aerosol_fields%get_field('cor_sol_su', cor_sol_su)
    call aerosol_fields%get_field('cor_sol_bc', cor_sol_bc)
    call aerosol_fields%get_field('cor_sol_om', cor_sol_om)
    call aerosol_fields%get_field('cor_sol_ss', cor_sol_ss)
    call aerosol_fields%get_field('n_ait_ins', n_ait_ins)
    call aerosol_fields%get_field('ait_ins_bc', ait_ins_bc)
    call aerosol_fields%get_field('ait_ins_om', ait_ins_om)
    call aerosol_fields%get_field('n_acc_ins', n_acc_ins)
    call aerosol_fields%get_field('acc_ins_du', acc_ins_du)
    call aerosol_fields%get_field('n_cor_ins', n_cor_ins)
    call aerosol_fields%get_field('cor_ins_du', cor_ins_du)

    call aerosol_fields%get_field('cloud_drop_no_conc', cloud_drop_no_conc)
    call aerosol_fields%get_field('drydp_ait_sol', drydp_ait_sol)
    call aerosol_fields%get_field('drydp_acc_sol', drydp_acc_sol)
    call aerosol_fields%get_field('drydp_cor_sol', drydp_cor_sol)
    call aerosol_fields%get_field('drydp_ait_ins', drydp_ait_ins)
    call aerosol_fields%get_field('drydp_acc_ins', drydp_acc_ins)
    call aerosol_fields%get_field('drydp_cor_ins', drydp_cor_ins)
    call aerosol_fields%get_field('wetdp_ait_sol', wetdp_ait_sol)
    call aerosol_fields%get_field('wetdp_acc_sol', wetdp_acc_sol)
    call aerosol_fields%get_field('wetdp_cor_sol', wetdp_cor_sol)
    call aerosol_fields%get_field('rhopar_ait_sol', rhopar_ait_sol)
    call aerosol_fields%get_field('rhopar_acc_sol', rhopar_acc_sol)
    call aerosol_fields%get_field('rhopar_cor_sol', rhopar_cor_sol)
    call aerosol_fields%get_field('rhopar_ait_ins', rhopar_ait_ins)
    call aerosol_fields%get_field('rhopar_acc_ins', rhopar_acc_ins)
    call aerosol_fields%get_field('rhopar_cor_ins', rhopar_cor_ins)
    call aerosol_fields%get_field('pvol_wat_ait_sol', pvol_wat_ait_sol)
    call aerosol_fields%get_field('pvol_wat_acc_sol', pvol_wat_acc_sol)
    call aerosol_fields%get_field('pvol_wat_cor_sol', pvol_wat_cor_sol)
    call aerosol_fields%get_field('pvol_su_ait_sol', pvol_su_ait_sol)
    call aerosol_fields%get_field('pvol_bc_ait_sol', pvol_bc_ait_sol)
    call aerosol_fields%get_field('pvol_om_ait_sol', pvol_om_ait_sol)
    call aerosol_fields%get_field('pvol_su_acc_sol', pvol_su_acc_sol)
    call aerosol_fields%get_field('pvol_bc_acc_sol', pvol_bc_acc_sol)
    call aerosol_fields%get_field('pvol_om_acc_sol', pvol_om_acc_sol)
    call aerosol_fields%get_field('pvol_ss_acc_sol', pvol_ss_acc_sol)
    call aerosol_fields%get_field('pvol_su_cor_sol', pvol_su_cor_sol)
    call aerosol_fields%get_field('pvol_bc_cor_sol', pvol_bc_cor_sol)
    call aerosol_fields%get_field('pvol_om_cor_sol', pvol_om_cor_sol)
    call aerosol_fields%get_field('pvol_ss_cor_sol', pvol_ss_cor_sol)
    call aerosol_fields%get_field('pvol_bc_ait_ins', pvol_bc_ait_ins)
    call aerosol_fields%get_field('pvol_om_ait_ins', pvol_om_ait_ins)
    call aerosol_fields%get_field('pvol_du_acc_ins', pvol_du_acc_ins)
    call aerosol_fields%get_field('pvol_du_cor_ins', pvol_du_cor_ins)

    call aerosol_fields%get_field('dms_conc_ocean', dms_conc_ocean)
    call aerosol_fields%get_field('surf_wetness', surf_wetness)
    call aerosol_fields%get_field('dust_flux', dust_flux)

    ! Chemistry emissions
    ! 2-D emissions
    call chemistry_fields%get_field('emiss_c2h6',emiss_c2h6)
    call chemistry_fields%get_field('emiss_c3h8',emiss_c3h8)
    call chemistry_fields%get_field('emiss_c5h8',emiss_c5h8)
    call chemistry_fields%get_field('emiss_ch4',emiss_ch4)
    call chemistry_fields%get_field('emiss_co',emiss_co)
    call chemistry_fields%get_field('emiss_hcho',emiss_hcho)
    call chemistry_fields%get_field('emiss_me2co',emiss_me2co)
    call chemistry_fields%get_field('emiss_mecho',emiss_mecho)
    call chemistry_fields%get_field('emiss_meoh',emiss_meoh)
    call chemistry_fields%get_field('emiss_nh3',emiss_nh3)
    call chemistry_fields%get_field('emiss_no',emiss_no)
    ! 3-D emissions
    call chemistry_fields%get_field('emiss_no_aircrft',emiss_no_aircrft)

    ! Aerosol emissions
    ! 2-D emissions
    call aerosol_fields%get_field('emiss_bc_biofuel', emiss_bc_biofuel)
    call aerosol_fields%get_field('emiss_bc_biomass_high', emiss_bc_biomass_high)
    call aerosol_fields%get_field('emiss_bc_biomass_low', emiss_bc_biomass_low)
    call aerosol_fields%get_field('emiss_bc_fossil', emiss_bc_fossil)
    call aerosol_fields%get_field('emiss_dms_land', emiss_dms_land)
    call aerosol_fields%get_field('emiss_monoterp', emiss_monoterp)
    call aerosol_fields%get_field('emiss_om_biofuel', emiss_om_biofuel)
    call aerosol_fields%get_field('emiss_om_biomass_high', emiss_om_biomass_high)
    call aerosol_fields%get_field('emiss_om_biomass_low', emiss_om_biomass_low)
    call aerosol_fields%get_field('emiss_om_fossil', emiss_om_fossil)
    call aerosol_fields%get_field('emiss_so2_high', emiss_so2_high)
    call aerosol_fields%get_field('emiss_so2_low', emiss_so2_low)
    ! 3-D emissions
    call aerosol_fields%get_field('emiss_bc_biomass', emiss_bc_biomass)
    call aerosol_fields%get_field('emiss_om_biomass', emiss_om_biomass)
    call aerosol_fields%get_field('emiss_so2_nat', emiss_so2_nat)

    ! Get location, level heights, cell area and volume data

    mesh => sin_stellar_declination_rts%get_mesh()   ! 2-D mesh
    latitude_w3  => get_latitude_fv(W3, mesh%get_id())
    longitude_w3 => get_longitude_fv(W3, mesh%get_id())
    cell_area => get_da_msl_proj(mesh%get_id())

    mesh => state(igh_t)%get_mesh()                  ! 3-D mesh
    height_wth => get_height_fv( Wtheta, mesh%get_id() )
    height_w3 => get_height_fv( W3, mesh%get_id() )
    rdz_w3    => get_rdz_w3( mesh%get_id() )


    ! Get detj on shifted W3 grid (to use as grid_volume)
    shifted_mesh => mesh_collection%get_mesh(mesh, SHIFTED)
    detj_shifted => get_detj_at_w3_fv(shifted_mesh%get_id())

    ! The call to um_sizes_init is required to ensure that the parent
    ! callback routine bl_tracer_mix passed to UKCA is compatible with
    ! row_length in the UKCA configuration.
    ! This is because bl_tracer_mix calls tr_mix which is dependent on the
    ! variable pdims defined in UM module atm_fields_bounds_mod that is
    ! affected by row_length.
    if (coarse_rad_aerosol) then
      ! Get meshes
      aero_mesh => cor_ins_du%get_mesh()
      aero_2d_mesh  => mesh_collection%get_mesh(aero_mesh, TWOD)
      shifted_aero_mesh => mesh_collection%get_mesh(aero_mesh, SHIFTED)
      ! Coarse Dust Fields
      ! =================== Runtime Fields ============================== !
      latitude_w3_aero => get_latitude_fv(W3, aero_mesh%get_id())  ! Runtime
      longitude_w3_aero => get_longitude_fv(W3, aero_mesh%get_id()) ! Runtime
      height_w3_aero  =>  get_height_fv( W3, aero_mesh%get_id() )! Runtime
      height_wth_aero  => get_height_fv( Wtheta, aero_mesh%get_id() ) ! Runtime
      rdz_w3_aero => get_rdz_w3( aero_mesh%get_id() )      ! Runtime
      cell_area_aero  => get_da_msl_proj(aero_mesh%get_id())   ! Runtime
      detj_shifted_aero => get_detj_at_w3_fv(shifted_aero_mesh%get_id())! Runtime

      ! =================== Tile Fields ============================== !
      w3_2d_multidata_coarse => function_space_collection%get_fs( aero_2d_mesh,  0, 0, &
                                                                  W3, get_ndata_val('surface_tiles'))
      call tile_fraction_coarse%initialise( w3_2d_multidata_coarse, 'tile_fraction_coarse')
      call tile_temperature_coarse%initialise( w3_2d_multidata_coarse, 'tile_temperature_coarse')
      
      call invoke( setval_c(tile_fraction_coarse, 0.0_r_def), &
                  setval_c(tile_temperature_coarse, 0.0_r_def) )
      call log_event( 'Mapping tile_fraction', LOG_LEVEL_INFO )
      call map_scalar_intermesh(tile_fraction_coarse, tile_fraction)
      call log_event( 'Mapping tile_temperature', LOG_LEVEL_INFO )
      call map_scalar_intermesh(tile_temperature_coarse, tile_temperature)

      tile_fraction_aero => tile_fraction_coarse
      tile_temperature_aero => tile_temperature_coarse

      ! =================== Scalar W3/WTHETA Fields ============================== !
      wth_coarse => function_space_collection%get_fs( aero_mesh, 0, 0, WTHETA )
      w3_coarse => function_space_collection%get_fs( aero_mesh,  0, 0, W3 )
      w3_2d_coarse => function_space_collection%get_fs( aero_2d_mesh,  0, 0, W3 )

      ! Initialise Fields
      call o3p_coarse%initialise( wth_coarse, 'o3p_coarse')
      call ls_rain_3d_coarse%initialise( wth_coarse, 'ls_rain_3d_coarse')
      call ls_snow_3d_coarse%initialise( wth_coarse, 'ls_snow_3d_coarse')
      call autoconv_coarse%initialise( wth_coarse, 'autoconv_coarse')
      call accretion_coarse%initialise( wth_coarse, 'accretion_coarse')
      call rim_cry_coarse%initialise( wth_coarse, 'rim_cry_coarse')
      call rim_agg_coarse%initialise( wth_coarse, 'rim_agg_coarse')
      call theta_coarse%initialise( wth_coarse, 'theta_coarse')
      call exner_in_wth_coarse%initialise( wth_coarse, 'exner_in_wth_coarse')
      call conv_rain_3d_coarse%initialise( wth_coarse, 'conv_rain_3d_coarse')
      call conv_snow_3d_coarse%initialise( wth_coarse, 'conv_snow_3d_coarse')
      call cca_coarse%initialise( wth_coarse, 'cca_coarse')
      call bulk_fraction_coarse%initialise( wth_coarse, 'bulk_fraction_coarse')
      call liquid_fraction_coarse%initialise( wth_coarse, 'liquid_fraction_coarse')
      call area_fraction_coarse%initialise( wth_coarse, 'area_fraction_coarse')

      call exner_coarse%initialise( w3_coarse, 'exner_coarse')
      call z0m_coarse%initialise( w3_2d_coarse, 'z0m_coarse')
      call ustar_coarse%initialise( w3_2d_coarse, 'ustar_coarse')
      call zh_coarse%initialise( w3_2d_coarse, 'zh_coarse')
      call rhokh_bl_coarse%initialise( w3_coarse, 'rhokh_bl_coarse')
      call zhsc_coarse%initialise( w3_2d_coarse, 'zhsc_coarse')

      call invoke( setval_c(o3p_coarse, 0.0_r_def), &
                   setval_c(ls_rain_3d_coarse, 0.0_r_def), &
                   setval_c(ls_snow_3d_coarse, 0.0_r_def), & 
                   setval_c(autoconv_coarse, 0.0_r_def), &
                    setval_c(accretion_coarse, 0.0_r_def), &
                    setval_c(rim_cry_coarse, 0.0_r_def), &
                    setval_c(rim_agg_coarse, 0.0_r_def), &
                    setval_c(theta_coarse, 0.0_r_def), &
                    setval_c(exner_in_wth_coarse, 0.0_r_def), &
                    setval_c(conv_rain_3d_coarse, 0.0_r_def), &
                    setval_c(conv_snow_3d_coarse, 0.0_r_def), &
                    setval_c(cca_coarse, 0.0_r_def), &
                    setval_c(bulk_fraction_coarse, 0.0_r_def), &
                    setval_c(liquid_fraction_coarse, 0.0_r_def), &
                    setval_c(area_fraction_coarse, 0.0_r_def), &
                    setval_c(exner_coarse, 0.0_r_def), &
                    setval_c(z0m_coarse, 0.0_r_def), &
                    setval_c(ustar_coarse, 0.0_r_def), &
                    setval_c(zh_coarse, 0.0_r_def), &
                    setval_c(rhokh_bl_coarse, 0.0_r_def), &
                    setval_c(zhsc_coarse, 0.0_r_def) )

      ! Map Fields
      call log_event( 'Mapping o3p', LOG_LEVEL_INFO )
      call map_scalar_intermesh(o3p_coarse, o3p)
      
      call log_event( 'Mapping ls_rain_3d', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ls_rain_3d_coarse, ls_rain_3d)
      
      call log_event( 'Mapping ls_snow_3d', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ls_snow_3d_coarse, ls_snow_3d)
      
      call log_event( 'Mapping autoconv', LOG_LEVEL_INFO )
      call map_scalar_intermesh(autoconv_coarse, autoconv)
      
      call log_event( 'Mapping accretion', LOG_LEVEL_INFO )
      call map_scalar_intermesh(accretion_coarse, accretion)
      
      call log_event( 'Mapping rim_cry', LOG_LEVEL_INFO )
      call map_scalar_intermesh(rim_cry_coarse, rim_cry)
      
      call log_event( 'Mapping rim_agg', LOG_LEVEL_INFO )
      call map_scalar_intermesh(rim_agg_coarse, rim_agg)
      
      call log_event( 'Mapping theta', LOG_LEVEL_INFO )
      call map_scalar_intermesh(theta_coarse, state(igh_t))
      
       call log_event( 'Mapping exner_wth', LOG_LEVEL_INFO )
      call map_scalar_intermesh(exner_in_wth_coarse, exner_in_wth)
      
      call log_event( 'Mapping conv_rain_3d', LOG_LEVEL_INFO )
      call map_scalar_intermesh(conv_rain_3d_coarse, conv_rain_3d)
      
      call log_event( 'Mapping conv_snow_3d', LOG_LEVEL_INFO )
      call map_scalar_intermesh(conv_snow_3d_coarse, conv_snow_3d)
      
      call log_event( 'Mapping cca', LOG_LEVEL_INFO )
      call map_scalar_intermesh(cca_coarse, cca)
      
      call log_event( 'Mapping bulk_fraction', LOG_LEVEL_INFO )
      call map_scalar_intermesh(bulk_fraction_coarse, bulk_fraction)
      
      call log_event( 'Mapping liquid_fraction', LOG_LEVEL_INFO )
      call map_scalar_intermesh(liquid_fraction_coarse, liquid_fraction)
      
      call log_event( 'Mapping area_fraction', LOG_LEVEL_INFO )
      call map_scalar_intermesh(area_fraction_coarse, area_fraction)
      
      call log_event( 'Mapping exner', LOG_LEVEL_INFO )
      call map_scalar_intermesh(exner_coarse, state(igh_p))
      
      call log_event( 'Mapping z0m', LOG_LEVEL_INFO )
      call map_scalar_intermesh(z0m_coarse, z0m)
      
      call log_event( 'Mapping ustar', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ustar_coarse, ustar)
      
      call log_event( 'Mapping zh', LOG_LEVEL_INFO )
      call map_scalar_intermesh(zh_coarse, zh)
      
      call log_event( 'Mapping rhokh_bl', LOG_LEVEL_INFO )
      call map_scalar_intermesh(rhokh_bl_coarse, rhokh_bl)
      
      call log_event( 'Mapping zhsc', LOG_LEVEL_INFO )
      call map_scalar_intermesh(zhsc_coarse, zhsc)


      ! Pointers to Fields
      o3p_aero => o3p_coarse
      ls_rain_3d_aero => ls_rain_3d_coarse
      ls_snow_3d_aero => ls_snow_3d_coarse
      autoconv_aero => autoconv_coarse
      accretion_aero => accretion_coarse
      rim_cry_aero => rim_cry_coarse
      rim_agg_aero => rim_agg_coarse
      theta_aero => theta_coarse
      exner_aero => exner_coarse
      exner_in_wth_aero => exner_in_wth_coarse
      conv_rain_3d_aero => conv_rain_3d_coarse
      conv_snow_3d_aero => conv_snow_3d_coarse
      cca_aero => cca_coarse
      bulk_fraction_aero => bulk_fraction_coarse
      liquid_fraction_aero => liquid_fraction_coarse
      area_fraction_aero => area_fraction_coarse
      z0m_aero => z0m_coarse
      ustar_aero => ustar_coarse
      zh_aero => zh_coarse
      rhokh_bl_aero => rhokh_bl_coarse
      zhsc_aero => zhsc_coarse

    ! =================== Multidata Scalar W3 Fields ============================== !
      w3_2d_multidata_coarse => function_space_collection%get_fs( aero_2d_mesh, &
                                                                   0, 0, W3, &
                                                                  get_ndata_val('dust_divisions'))
      call dust_flux_coarse%initialise( w3_2d_multidata_coarse, 'dust_flux_coarse')

      w3_2d_multidata_coarse => function_space_collection%get_fs( aero_2d_mesh, &
                                                                   0, 0, W3, &
                                                                  get_ndata_val('entrainment_levels'))
      call ent_we_lim_coarse%initialise( w3_2d_multidata_coarse, 'ent_we_lim_coarse')
      call ent_t_frac_coarse%initialise( w3_2d_multidata_coarse, 'ent_t_frac_coarse')
      call ent_zrzi_coarse%initialise( w3_2d_multidata_coarse, 'ent_zrzi_coarse')
      call ent_we_lim_dsc_coarse%initialise( w3_2d_multidata_coarse, 'ent_we_lim')
      call ent_zrzi_dsc_coarse%initialise( w3_2d_multidata_coarse, 'ent_zrzi_dsc')

      call invoke( setval_c(dust_flux_coarse, 0.0_r_def), &
                   setval_c(ent_we_lim_coarse, 0.0_r_def), &
                    setval_c(ent_t_frac_coarse, 0.0_r_def), &
                    setval_c(ent_zrzi_coarse, 0.0_r_def), &
                    setval_c(ent_we_lim_dsc_coarse, 0.0_r_def), &
                    setval_c(ent_zrzi_dsc_coarse, 0.0_r_def) )
      
      call log_event( 'Mapping dust_flux', LOG_LEVEL_INFO )
      call map_scalar_intermesh(dust_flux_coarse, dust_flux)
      
      call log_event( 'Mapping ent_we_lim', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ent_we_lim_coarse, ent_we_lim)
      
      call log_event( 'Mapping ent_t_frac', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ent_t_frac_coarse, ent_t_frac)
      
      call log_event( 'Mapping ent_zrzi', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ent_zrzi_coarse, ent_zrzi)
      
      call log_event( 'Mapping ent_we_lim_dsc', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ent_we_lim_dsc_coarse, ent_we_lim_dsc)
      
      call log_event( 'Mapping ent_zrzi_dsc', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ent_zrzi_dsc_coarse, ent_zrzi_dsc)

      dust_flux_aero => dust_flux_coarse
      ent_we_lim_aero => ent_we_lim_coarse
      ent_t_frac_aero => ent_t_frac_coarse
      ent_zrzi_aero => ent_zrzi_coarse
      ent_we_lim_dsc_aero => ent_we_lim_dsc_coarse
      ent_zrzi_dsc_aero => ent_zrzi_dsc_coarse

      ! =================== Integer W3/WTHETA Fields ============================== !

      call cv_base_coarse%initialise( w3_2d_coarse, 'cv_base_coarse')
      call cv_top_coarse%initialise( w3_2d_coarse, 'cv_top_coarse')
      call level_ent_coarse%initialise( w3_2d_coarse, 'level_ent_coarse')
      call level_ent_dsc_coarse%initialise( w3_2d_coarse, 'level_ent_dsc_coarse')

      call invoke( setval_c(cv_base_coarse, 0.0_r_def), &
                  setval_c(cv_top_coarse, 0.0_r_def) )
      call log_event( 'Mapping cv_base', LOG_LEVEL_INFO )
      call map_scalar_intermesh(cv_base_coarse, cv_base, lowest_order_flag=.true.)
      
      call log_event( 'Mapping cv_top', LOG_LEVEL_INFO )
      call map_scalar_intermesh(cv_top_coarse, cv_top, lowest_order_flag=.true.)

      ! Round to nearest integer
      call round_to_integer(cv_top_coarse)
      call round_to_integer(cv_base_coarse)
      call log_field_minmax(LOG_LEVEL_INFO, 'cv_base_coarse', cv_base_coarse)
      call log_field_minmax(LOG_LEVEL_INFO, 'cv_top_coarse', cv_top_coarse)
      
      call log_event( 'Mapping ent', LOG_LEVEL_INFO )
      call map_integer_intermesh(level_ent_coarse, level_ent, aero_mesh, mesh)
      
      call log_event( 'Mapping ent_dsc', LOG_LEVEL_INFO )
      call map_integer_intermesh(level_ent_dsc_coarse, level_ent_dsc, aero_mesh, mesh)

      cv_base_aero => cv_base_coarse
      cv_top_aero => cv_top_coarse
      level_ent_aero => level_ent_coarse
      level_ent_dsc_aero => level_ent_dsc_coarse


      ! =================== Moisture Fields ============================== !
      call rho_coarse%initialise(vector_space = w3_coarse)
      do i_mr = 1, nummr
        call mr_coarse(i_mr)%initialise(vector_space = wth_coarse)
      end do
      call log_event( 'Mapping rho', LOG_LEVEL_INFO )
      call map_rho_intermesh(rho_coarse, state(igh_d))   
      
      call log_event( 'Mapping mr', LOG_LEVEL_INFO )
      call map_mr_bundle_intermesh(mr_coarse, mr, rho_coarse, state(igh_d))
      ! Calculate total ice field
      call mr_coarse(imr_ci)%copy_field_properties(mr_ice_coarse)
      call invoke(setval_X(mr_ice_coarse, mr_coarse(imr_ci)))
      if (microphysics_casim) then
        call invoke(inc_X_plus_Y(mr_ice_coarse, mr_coarse(imr_s)))
      end if

      

      mr_aero => mr_coarse
      mr_ice_aero => mr_ice_coarse

      ! =================== Compute Again Fields ============================== !

      ! Initialise Fields
      call wetrho_in_w3_coarse%initialise( w3_coarse, 'wetrho_in_w3_coarse')
      call wetrho_in_wth_coarse%initialise( wth_coarse, 'wetrho_in_wth_coarse')
      call ent_t_frac_dsc_coarse%initialise( w3_2d_multidata_coarse, 'ent_t_frac_dsc_coarse')
      call dtrdz_tq_bl_coarse%initialise( wth_coarse, 'dtrdz_tq_bl_coarse')
      call rho_in_wth_coarse%initialise(wth_coarse, 'rho_in_wth_coarse')
      !call map_scalar_intermesh(dtrdz_tq_bl_coarse, dtrdz_tq_bl)

      dtrdz_coarse_wtheta => get_dtrdz_wth(aero_mesh%get_id(), clock)
      call map_physics_scalars(rho_in_wth_coarse, rho_coarse)
      call invoke(setval_X(dtrdz_tq_bl_coarse, dtrdz_coarse_wtheta))
      call invoke( inc_X_divideby_Y(dtrdz_tq_bl_coarse,  rho_in_wth_coarse) )

      ! Fields required for recomputation
      !call rho_in_wth_coarse%initialise(vector_space = wth_coarse
      call cos_zenith_angle_coarse%initialise(vector_space = w3_2d_coarse)
      call lit_fraction_coarse%initialise(vector_space = w3_2d_coarse)
      call cos_zenith_angle_rts_coarse%initialise(vector_space = w3_2d_coarse)
      call lit_fraction_rts_coarse%initialise(vector_space = w3_2d_coarse)
      call stellar_irradiance_rts_coarse%initialise(vector_space = w3_2d_coarse)
      call sin_stellar_declination_rts_coarse%initialise(vector_space = w3_2d_coarse)
      call stellar_eqn_of_time_rts_coarse%initialise(vector_space = w3_2d_coarse)
      call orographic_correction_rts_coarse%initialise(vector_space = w3_2d_coarse)
    
      call slope_angle_coarse%initialise(vector_space = w3_2d_coarse)
      call slope_aspect_coarse%initialise(vector_space = w3_2d_coarse)

      ! Multidata?
      w3_2d_multidata_coarse => function_space_collection%get_fs( aero_2d_mesh,  0, 0, &
                                                                  W3, get_ndata_val('horizon_angles'))
      call horizon_angle_coarse%initialise(vector_space = w3_2d_multidata_coarse)
      w3_2d_multidata_coarse => function_space_collection%get_fs( aero_2d_mesh,  0, 0, &
                                                                  W3, get_ndata_val('horizon_aspects'))
      call horizon_aspect_coarse%initialise(vector_space = w3_2d_multidata_coarse)

      do i_mr = 1, num_moist_factors
        call moist_dyn_coarse(i_mr)%initialise(vector_space = wth_coarse)
      end do

      ! Set Fields
      call invoke( setval_c(wetrho_in_w3_coarse, 0.0_r_def), &
                  setval_c(wetrho_in_wth_coarse, 0.0_r_def), &
                  setval_c(ent_t_frac_dsc_coarse, 0.0_r_def) )
      ! Compute wetrho fields
      !call map_physics_scalars(rho_in_wth_coarse,   rho_coarse)
      call moist_dyn_factors_alg(moist_dyn_coarse, mr_coarse)
      call invoke(X_times_Y(wetrho_in_wth_coarse, rho_in_wth_coarse, moist_dyn_coarse(total_mass)))
      call map_physics_scalars(wetrho_in_w3_coarse, wetrho_in_wth_coarse)

      ! Compute turbulence fields
      call log_event( 'Mapping ent_t_frac_dsc', LOG_LEVEL_INFO )
      call map_scalar_intermesh(ent_t_frac_dsc_coarse, ent_t_frac_dsc)

      call log_field_minmax( LOG_LEVEL_INFO, ' wetrho_in_w3_coarse ', wetrho_in_w3_coarse )
      call log_field_minmax( LOG_LEVEL_INFO, ' wetrho_in_wth_coarse ', wetrho_in_wth_coarse )
      call log_field_minmax( LOG_LEVEL_INFO, ' dtrdz_tq_bl_coarse', dtrdz_tq_bl_coarse )

      
      ! Compute radiation fields
      ! In: slope_angle, slope_aspect, horizon_angle, horizon_aspect, latitude, longitude
      ! Out: cos_zenith_angle, lit_fraction, orographic_correction_rts
      ! In/Out: cos_zenith_angle_rts, lit_fraction_rts, stellar_irradiance_rts, 
      ! sin_stellar_declination_rts, stellar_eqn_of_time_rts 
      call invoke ( setval_c(slope_angle_coarse, 0.0_r_def), &
                    setval_c(slope_aspect_coarse, 0.0_r_def), &
                    setval_c(horizon_angle_coarse, 0.0_r_def), &
                    setval_c(horizon_aspect_coarse, 0.0_r_def), &
                    setval_c(cos_zenith_angle_coarse, 0.0_r_def), &
                    setval_c(lit_fraction_coarse, 0.0_r_def), &
                    setval_c(cos_zenith_angle_rts_coarse, 0.0_r_def), &
                    setval_c(lit_fraction_rts_coarse, 0.0_r_def), &
                    setval_c(stellar_irradiance_rts_coarse, 0.0_r_def), &
                    setval_c(sin_stellar_declination_rts_coarse, 0.0_r_def), &
                    setval_c(stellar_eqn_of_time_rts_coarse, 0.0_r_def), &
                    setval_c(orographic_correction_rts_coarse, 0.0_r_def) )
      
      if (.not. first_call) then

        ! call invoke( illuminate_kernel_type( &
        !               cos_zenith_angle_coarse, lit_fraction_coarse, &
        !               cos_zenith_angle_rts_coarse, lit_fraction_rts_coarse, &
        !               stellar_irradiance_rts_coarse, &
        !               sin_stellar_declination_rts_coarse, &
        !               stellar_eqn_of_time_rts_coarse, &
        !               orographic_correction_rts_coarse, &
        !               slope_angle_coarse, slope_aspect_coarse, &
        !               horizon_angle_coarse, horizon_aspect_coarse, &
        !               latitude_w3_aero, longitude_w3_aero, timestep_number, dt, &
        !               current_year, day_of_year, second_of_day) )
        call map_scalar_intermesh(sin_stellar_declination_rts_coarse, sin_stellar_declination_rts)
        call map_scalar_intermesh(stellar_eqn_of_time_rts_coarse, stellar_eqn_of_time_rts)
      else
        call map_scalar_intermesh(sin_stellar_declination_rts_coarse, sin_stellar_declination_rts)
        call map_scalar_intermesh(stellar_eqn_of_time_rts_coarse, stellar_eqn_of_time_rts)
      end if
      ! Get date and time
      call xios_get_current_date(datetime)
      current_year  = int(datetime%year, i_def)
      day_of_year   = int(xios_date_get_day_of_year(datetime), i_def) + 1_i_def
      second_of_day = real(xios_date_get_second_of_day(datetime), r_def)
      first_call = .false.
      ! Pointers
      wetrho_in_w3_aero => wetrho_in_w3_coarse
      wetrho_in_wth_aero => wetrho_in_wth_coarse
      ent_t_frac_dsc_aero => ent_t_frac_dsc_coarse
      dtrdz_tq_bl_aero => dtrdz_tq_bl_coarse
      sin_stellar_declination_rts_aero => sin_stellar_declination_rts_coarse
      stellar_eqn_of_time_rts_aero => stellar_eqn_of_time_rts_coarse

      call log_field_minmax( LOG_LEVEL_INFO, ' stellar_eqn_of_time_rts_coarse ', stellar_eqn_of_time_rts_coarse )
      call log_field_minmax( LOG_LEVEL_INFO, ' sin_stellar_declination_rts_coarse ', sin_stellar_declination_rts_coarse )

      ncells = aero_mesh%get_last_edge_cell()
    
    else
      latitude_w3_aero => get_latitude_fv(W3, mesh%get_id())  ! Runtime
      longitude_w3_aero => get_longitude_fv(W3, mesh%get_id()) ! Runtime
      height_w3_aero  =>  get_height_fv( W3, mesh%get_id() )! Runtime
      height_wth_aero  => get_height_fv( Wtheta, mesh%get_id() ) ! Runtime
      rdz_w3_aero => get_rdz_w3( mesh%get_id() )      ! Runtime
      cell_area_aero  => get_da_msl_proj(mesh%get_id())   ! Runtime
      detj_shifted_aero => get_detj_at_w3_fv(shifted_mesh%get_id())! Runtime

      call chemistry_fields%get_field('o3p', o3p_aero)
      call microphysics_fields%get_field('ls_rain_3d', ls_rain_3d_aero)
      call microphysics_fields%get_field('ls_snow_3d', ls_snow_3d_aero)
      call microphysics_fields%get_field('autoconv', autoconv_aero)
      call microphysics_fields%get_field('accretion', accretion_aero)
      call microphysics_fields%get_field('rim_cry', rim_cry_aero)
      call microphysics_fields%get_field('rim_agg', rim_agg_aero)

      wth_coarse => function_space_collection%get_fs( mesh,  0, 0, WTHETA )
      w3_coarse => function_space_collection%get_fs( mesh,  0, 0, W3 )

      do i_mr = 1, nummr
        call mr_coarse(i_mr)%initialise(vector_space = wth_coarse)
        call invoke( setval_X(mr_coarse(i_mr), mr(i_mr)) )
      end do
      ! Calculate total ice field
      call mr_coarse(imr_ci)%copy_field_properties(mr_ice_coarse)
      call invoke(setval_X(mr_ice_coarse, mr_coarse(imr_ci)))
  
      mr_aero => mr_coarse
      mr_ice_aero => mr_ice_coarse

      ! Initialise Fields
      call theta_coarse%initialise( wth_coarse, 'theta_coarse')
      call exner_coarse%initialise( w3_coarse, 'exner_coarse')
      call invoke ( setval_X(theta_coarse, state(igh_t)), &
                   setval_X(exner_coarse, state(igh_p)) )
      theta_aero => theta_coarse
      exner_aero => exner_coarse
      call derived_fields%get_field('exner_in_wth', exner_in_wth_aero)
     
      call convection_fields%get_field('conv_rain_3d', conv_rain_3d_aero)
      call convection_fields%get_field('conv_snow_3d', conv_snow_3d_aero)
      call convection_fields%get_field('cca', cca_aero)

      call cloud_fields%get_field('bulk_fraction', bulk_fraction_aero)
      call cloud_fields%get_field('liquid_fraction', liquid_fraction_aero)
      call cloud_fields%get_field('area_fraction', area_fraction_aero)
      call surface_fields%get_field('z0m', z0m_aero)
      call surface_fields%get_field('ustar', ustar_aero)
      
      call turbulence_fields%get_field('zh', zh_aero)
      call turbulence_fields%get_field('rhokh_bl', rhokh_bl_aero)
      call turbulence_fields%get_field('zhsc', zhsc_aero)

      call aerosol_fields%get_field('dust_flux', dust_flux_aero)

      call turbulence_fields%get_field('ent_we_lim', ent_we_lim_aero)
      call turbulence_fields%get_field('ent_t_frac', ent_t_frac_aero)
      call turbulence_fields%get_field('ent_zrzi', ent_zrzi_aero)
      call turbulence_fields%get_field('ent_we_lim_dsc', ent_we_lim_dsc_aero)
      call turbulence_fields%get_field('ent_zrzi_dsc', ent_zrzi_dsc_aero)

      call convection_fields%get_field('cv_base', cv_base_aero)
      call convection_fields%get_field('cv_top', cv_top_aero)
      call turbulence_fields%get_field('level_ent', level_ent_aero)
      call turbulence_fields%get_field('level_ent_dsc', level_ent_dsc_aero)

      call derived_fields%get_field('wetrho_in_w3', wetrho_in_w3_aero)
      call derived_fields%get_field('wetrho_in_wth', wetrho_in_wth_aero)

      call turbulence_fields%get_field('ent_t_frac_dsc', ent_t_frac_dsc_aero)
      call turbulence_fields%get_field('dtrdz_tq_bl', dtrdz_tq_bl_aero)
      call radiation_fields%get_field('sin_stellar_declination_rts', sin_stellar_declination_rts_aero)
      call radiation_fields%get_field('stellar_eqn_of_time_rts', stellar_eqn_of_time_rts_aero)

      call surface_fields%get_field('tile_fraction', tile_fraction_aero)
      call surface_fields%get_field('tile_temperature', tile_temperature_aero)


      ncells = mesh%get_last_edge_cell()

      call log_field_minmax( LOG_LEVEL_INFO, ' stellar_eqn_of_time_rts ', stellar_eqn_of_time_rts_aero )
      call log_field_minmax( LOG_LEVEL_INFO, ' sin_stellar_declination_rts ', sin_stellar_declination_rts_aero )
      call log_field_minmax( LOG_LEVEL_INFO, 'wetrho_in_w3', wetrho_in_w3_aero )
      call log_field_minmax( LOG_LEVEL_INFO, 'wetrho_in_wth', wetrho_in_wth_aero )
      call log_field_minmax( LOG_LEVEL_INFO, 'dtrdz_tq_bl', dtrdz_tq_bl_aero )
    end if

    call um_sizes_init( ncells )

    ! Calculate total ice field
    call mr(imr_s)%copy_field_properties(mr_ice)
    call invoke(setval_X(mr_ice, mr(imr_s)))
    if (microphysics_casim) then
      call invoke(inc_X_plus_Y(mr_ice, mr(imr_ci)))
    end if
    
    ! Fields needed by UKCA and Photolysis
    call zh%copy_field_properties(conv_cloud_lwp)
    call zh%copy_field_properties(surf_albedo)

    call invoke( setval_c(conv_cloud_lwp, 0.0_r_def),                          &
                       setval_c(surf_albedo, 0.0_r_def) )
  
    ! Multi-dimensional field: photol_rates
    vector_space=>function_space_collection%get_fs(mesh,0,0,Wtheta,            &
                   get_ndata_val('photol_species') )

    call photol_rates%initialise(vector_space)
    call invoke( setval_c(photol_rates,    0.0_r_def) )

    if ( chem_scheme == chem_scheme_strattrop .and.                            &
         photol_scheme /= photol_scheme_off ) then
      ! Photolysis currently linked to Strattrop      

      ! Sample Rates to output; wtheta grid
      call ls_rain_3d%copy_field_properties(photol_rate_jo1d)
      call ls_rain_3d%copy_field_properties(photol_rate_jno2)

      call invoke( setval_c(photol_rate_jo1d,  0.0_r_def),                     &
                   setval_c(photol_rate_jno2,  0.0_r_def) )
      
      ! Only call photolysis if this is a chemistry timestep as photol rates
      ! are only used by chemistry
      if (mod( model_clock%get_step(),                                         &
            chem_timestep/int(model_clock%get_seconds_per_step()) ) == 0) then

        if ( subroutine_timers ) call timer('ukca_photolysis_alg')
        ! FastJX scheme
        if (photol_scheme == photol_scheme_fastjx )  then

          ! Allocate and initialise required fields
          ! sulp_accum, sulp_aitken and aod preset to values same as UM.
          call ls_rain_3d%copy_field_properties(sulp_accum)
          call ls_rain_3d%copy_field_properties(sulp_aitken)
          call ls_rain_3d%copy_field_properties(aod_sulp_accum)
          call ls_rain_3d%copy_field_properties(aod_sulp_aitken)
          call ls_rain_3d%copy_field_properties(photol_rates_rts_jo2)
          call ls_rain_3d%copy_field_properties(photol_rates_rts_jo2b)
          
          call invoke ( setval_c(sulp_accum,     1.0e-25_r_def),                &
                        setval_c(sulp_aitken,    1.0e-25_r_def),                &
                        setval_c(aod_sulp_accum, 1.0e3_r_def),                  &
                        setval_c(aod_sulp_aitken, 1.0e3_r_def),                 &
                        setval_c(photol_rates_rts_jo2,  0.0_r_def),             &
                        setval_c(photol_rates_rts_jo2b, 0.0_r_def) )

          ! Calculate Relative humidity (as fraction: 0.0-1.0)    
          call mr(imr_v)%copy_field_properties(msat)
          call mr(imr_v)%copy_field_properties(rel_humid_frac)
          call invoke( setval_c(msat,             0.0_r_def),                  &
                       setval_c(rel_humid_frac,   0.0_r_def),                  &
                       msat_kernel_type(msat, exner_in_wth,                    &
                                        state(igh_t), water_only),             &
                       X_divideby_Y(rel_humid_frac, mr(imr_v), msat),          &
                       inc_max_aX(0.0_r_def, rel_humid_frac),                  &
                       inc_min_aX(1.0_r_def, rel_humid_frac) )

          ! Derive required inputs, surface albedo first 
          call invoke ( calc_albedo_kernel_type ( surf_albedo,                 &
                                            sw_down_surf,                      &
                                            tile_fraction,                     &
                                            sw_up_tile),                       &
                        photol_kernel_type ( photol_rates,                     &
                                            current_time_year,                 &
                                            current_time_month,                &
                                            current_time_day,                  &
                                            current_time_hour,                 &
                                            current_time_minute,               &
                                            current_time_second,               &
                                            current_time_daynum,               &
                                            previous_time_hour,                &
                                            previous_time_minute,              &
                                            previous_time_second,              &
                                            o3,                                &
                                            state(igh_t),                      &
                                            exner_in_wth,                      &
                                            height_wth,                        &
                                            mr(imr_cl),                        &
                                            mr_ice,                            &
                                            rel_humid_frac,                    &
                                            cca,                               &
                                            area_fraction,                     &
                                            sulp_accum,                        &
                                            sulp_aitken,                       &
                                            aod_sulp_accum,                    &
                                            aod_sulp_aitken,                   &
                                            photol_rates_rts_jo2,              &
                                            photol_rates_rts_jo2b,             &
                                            height_w3,                         &
                                            state(igh_p),                      &
                                            tile_fraction,                     &
                                            latitude_w3,                       &
                                            longitude_w3,                      &
                                            sin_stellar_declination_rts,       &
                                            stellar_eqn_of_time_rts,           &
                                            conv_cloud_lwp,                    &
                                            surf_albedo,                       &
                                            cv_base,                           &
                                            cv_top ) )

            ! Extract sample rates from full array for verification
            ! Currently only rates for O1D and NO2 output, so ignore others
            do jp1 = 1, n_phot_spc
              select case(trim(ratj_varnames(jp1)))
              case ('jo3a')
                !  jO(1D)         
                call invoke (  photol_diags_kernel_type(photol_rate_jo1d,      &
                                                        jp1,                   &
                                                        photol_rates) )
              case ('jno2')
                !  jNO2
                call invoke (  photol_diags_kernel_type(photol_rate_jno2,      &
                                                        jp1,                   &
                                                        photol_rates) )
              end select
            end do
  
        end if  ! Fast-JX
      
        ! Specified photolysis rates - based on location and local time
        if ( photol_scheme == photol_scheme_prescribed ) then
          call ls_rain_3d%copy_field_properties(photol_rate_profile)

          call invoke ( pseudo_photol_kernel_type ( photol_rate_profile,       &
                                                    current_time_hour,         &
                                                    current_time_minute,       &
                                                    latitude_w3,               &
                                                    longitude_w3 ) )

          ! Expand the single base rate profile to all the photolytic species
          ! (num=jppj) involved in this chemistry scheme by scaling the values
          ! using a species-specific jrate_fac, derived from a sample UM run.
          loop_1 : do jp2 = 1, n_phot_spc
            loop_2 : do jp1 = 1, jppj
              if ( ratj_varnames(jp2) == trim(jp_names(jp1)) ) then
                 call invoke ( map_pseudophotol_kernel_type( photol_rates,     &
                                                        photol_rate_profile,   &
                                                        jp2,                   &
                                                        jrate_fac(jp1) ) )
                 exit loop_2
              end if
            end do loop_2
          end do loop_1

        end if  ! photol_scheme = fastjx/ prescribed

        if ( subroutine_timers ) call timer('ukca_photolysis_alg')
        
      end if  ! Chem timestep
    
    end if  ! Chem/ photolysis schemes

    ! Do UKCA time step

    call invoke(aerosol_ukca_kernel_type( o3p_aero,                                 &
                                          o1d,                                 &
                                          o3,                                  &
                                          n,                                   &
                                          no,                                  &
                                          no3,                                 &
                                          lumped_n,                            &
                                          no2,                                 &
                                          n2o5,                                &
                                          ho2no2,                              &
                                          hono2,                               &
                                          h2o2,                                &
                                          ch4,                                 &
                                          co,                                  &
                                          hcho,                                &
                                          meoo,                                &
                                          meooh,                               &
                                          h,                                   &
                                          oh,                                  &
                                          ho2,                                 &
                                          cl,                                  &
                                          cl2o2,                               &
                                          clo,                                 &
                                          oclo,                                &
                                          br,                                  &
                                          lumped_br,                           &
                                          bro,                                 &
                                          brcl,                                &
                                          brono2,                              &
                                          n2o,                                 &
                                          lumped_cl,                           &
                                          hcl,                                 &
                                          hocl,                                &
                                          hbr,                                 &
                                          hobr,                                &
                                          clono2,                              &
                                          cfcl3,                               &
                                          cf2cl2,                              &
                                          mebr,                                &
                                          hono,                                &
                                          c2h6,                                &
                                          etoo,                                &
                                          etooh,                               &
                                          mecho,                               &
                                          meco3,                               &
                                          pan,                                 &
                                          c3h8,                                &
                                          n_proo,                              &
                                          i_proo,                              &
                                          n_prooh,                             &
                                          i_prooh,                             &
                                          etcho,                               &
                                          etco3,                               &
                                          me2co,                               &
                                          mecoch2oo,                           &
                                          mecoch2ooh,                          &
                                          ppan,                                &
                                          meono2,                              &
                                          c5h8,                                &
                                          iso2,                                &
                                          isooh,                               &
                                          ison,                                &
                                          macr,                                &
                                          macro2,                              &
                                          macrooh,                             &
                                          mpan,                                &
                                          hacet,                               &
                                          mgly,                                &
                                          nald,                                &
                                          hcooh,                               &
                                          meco3h,                              &
                                          meco2h,                              &
                                          h2,                                  &
                                          meoh,                                &
                                          msa,                                 &
                                          nh3,                                 &
                                          cs2,                                 &
                                          csul,                                &
                                          h2s,                                 &
                                          so3,                                 &
                                          passive_o3,                          &
                                          age_of_air,                          &
                                          dms,                                 &
                                          so2,                                 &
                                          h2so4,                               &
                                          dmso,                                &
                                          monoterpene,                         &
                                          secondary_organic,                   &
                                          n_nuc_sol,                           &
                                          nuc_sol_su,                          &
                                          nuc_sol_om,                          &
                                          n_ait_sol,                           &
                                          ait_sol_su,                          &
                                          ait_sol_bc,                          &
                                          ait_sol_om,                          &
                                          n_acc_sol,                           &
                                          acc_sol_su,                          &
                                          acc_sol_bc,                          &
                                          acc_sol_om,                          &
                                          acc_sol_ss,                          &
