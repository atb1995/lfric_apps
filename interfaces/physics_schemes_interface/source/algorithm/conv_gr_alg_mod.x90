    type( field_type ) :: rho_coarse
    type(function_space_type), pointer :: wth_fine => null()
 	  type(function_space_type), pointer :: w3_coarse => null()
    type( field_type ), target :: n_acc_ins_fine
 	  type( field_type ), target :: acc_ins_du_fine
 	  type( field_type ), target :: n_cor_ins_fine
 		type( field_type ), target :: cor_ins_du_fine

    type( mesh_type ), pointer  :: mesh => null()
    type( mesh_type ), pointer  :: aerosol_mesh => null()

    if ( subroutine_timers ) call timer("conv_gr_alg")

    call log_event( 'Running GR convection scheme', LOG_LEVEL_DEBUG )

    mesh => rho%get_mesh()

    ! Unpack derived fields
    call derived_fields%get_field('exner_in_wth', exner_in_wth)
    call derived_fields%get_field('wetrho_in_wth', wetrho_in_wth)
