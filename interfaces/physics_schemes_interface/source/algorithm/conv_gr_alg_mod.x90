      call aerosol_fields%get_field('n_cor_ins', n_cor_ins_aero)
      call aerosol_fields%get_field('cor_ins_du', cor_ins_du_aero)
    end if

    ! Initialise the convection diagnostics
    call initialise_diags_for_conv(theta_star,           &
                                   rho,                  &
                                   zh,                   &
