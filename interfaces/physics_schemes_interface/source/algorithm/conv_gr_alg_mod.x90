 	  end if
    if ( subroutine_timers ) call timer("conv_gr_alg")

    ! output diagnostics on last iteration only
    if (write_diag .and. use_xios_io .and. outer == outer_iterations) then

      call output_diags_for_conv( cca,                   & ! prognostics
                                  ccw,                   &
                                  dt_conv,               & ! increments
                                  dmv_conv,              &
                                  dmcl_conv,             &
