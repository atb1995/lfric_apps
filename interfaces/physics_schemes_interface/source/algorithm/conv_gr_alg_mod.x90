      call map_mr_intermesh(meoo, meoo_aero, rho_coarse, rho)
      call map_mr_intermesh(meooh, meooh_aero, rho_coarse, rho)
      call map_mr_intermesh(h, h_aero, rho_coarse, rho)
      call map_mr_intermesh(oh, oh_aero, rho_coarse, rho)
      call map_mr_intermesh(ho2, ho2_aero, rho_coarse, rho)
      call map_mr_intermesh(cl, cl_aero, rho_coarse, rho)
      call map_mr_intermesh(cl2o2, cl2o2_aero, rho_coarse, rho)
      call map_mr_intermesh(clo, clo_aero, rho_coarse, rho)
      call map_mr_intermesh(oclo, oclo_aero, rho_coarse, rho)
      call map_mr_intermesh(br, br_aero, rho_coarse, rho)
