    if (coarse_rad_aerosol) then
      call map_mr_intermesh(n_acc_ins, n_acc_ins_aero, rho_coarse, rho)
      call map_mr_intermesh(acc_ins_du, acc_ins_du_aero, rho_coarse, rho)
      call map_mr_intermesh(n_cor_ins, n_cor_ins_aero, rho_coarse, rho)
      call map_mr_intermesh(cor_ins_du, cor_ins_du_aero, rho_coarse, rho)
      
      call map_mr_intermesh(o3p, o3p_aero, rho_coarse, rho)
      call map_mr_intermesh(o1d, o1d_aero, rho_coarse, rho)
      call map_mr_intermesh(o3, o3p_aero, rho_coarse, rho)
      call map_mr_intermesh(n, n_aero, rho_coarse, rho)
      call map_mr_intermesh(no, no_aero, rho_coarse, rho)
