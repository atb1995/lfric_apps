      call map_mr_intermesh(tnuc_nlcl_fine, tnuc_nlcl, rho, rho_coarse)
      
      ! Point _aero pointers to _fine fields
      acc_ins_du_aero => acc_ins_du_fine
      cor_ins_du_aero => cor_ins_du_fine
